{
  "name": "gfs-open",
  "version": "1.0.0",
  "description": "Eine klar gestaltete Desktop-Präsentationsvorlage für eine GFS. Das reduzierte Layout setzt auf Papierweiß, Schwarz und Rot statt auf typische KI-Verläufe.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "lint": "eslint . --ext .js,.ts",
    "format": "prettier --write .",
    "start": "serve dist -s -l tcp://0.0.0.0:${PORT:-3000}"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maxsdr12-max/gfs-open.git"
  },
  "keywords": [
    "presentation",
    "gfs",
    "slides",
    "editor"
  ],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/maxsdr12-max/gfs-open/issues"
  },
  "homepage": "https://github.com/maxsdr12-max/gfs-open#readme",
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "jsdom": "^31.0.1",
    "playwright": "^1.40.0",
    "vitest": "^1.0.0"
  },
  "dependencies": {
    "@types/node": "^20.10.0",
    "@vitejs/plugin-legacy": "^5.2.0",
    "html-to-image": "^1.11.11",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.2",
    "jszip": "^3.10.1",
    "pdfjs-dist": "^4.10.38",
    "serve": "^14.2.4",
    "terser": "^5.24.0",
    "typescript": "~5.9.3",
    "vite": "^5.0.0"
  }
}
